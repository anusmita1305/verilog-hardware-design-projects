`timescale 1ns/1ps

module tb_mux4to1;

    reg [7:0] in0, in1, in2, in3;
    reg [1:0] sel;
    wire [7:0] y;

    mux4to1 dut (
        .in0(in0),
        .in1(in1),
        .in2(in2),
        .in3(in3),
        .sel(sel),
        .y(y)
    );

    initial begin
        in0 = 8'hAA;
        in1 = 8'hBB;
        in2 = 8'hCC;
        in3 = 8'hDD;

        sel = 2'b00;
        #10;
        $display("sel=%b, y=%h", sel, y);

        sel = 2'b01;
        #10;
        $display("sel=%b, y=%h", sel, y);

        sel = 2'b10;
        #10;
        $display("sel=%b, y=%h", sel, y);

        sel = 2'b11;
        #10;
        $display("sel=%b, y=%h", sel, y);

        $finish;
    end

endmodule
