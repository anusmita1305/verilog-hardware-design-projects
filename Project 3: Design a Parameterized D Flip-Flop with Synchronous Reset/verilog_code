module dff_sync #(
    parameter WIDTH = 8,
    parameter RESET_VAL = 0
)(
    input wire clk,
    input wire rst,
    input wire en,
    input wire [WIDTH-1:0] d,
    output reg [WIDTH-1:0] q
);

    always @(posedge clk) begin
        if (rst)
            q <= {WIDTH{1'b0}};
        else if (en)
            q <= d;
    end

endmodule
