`timescale 1ns/1ps

module tb_decoder3to8;

    reg [2:0] in;
    reg en;
    wire [7:0] out;

    decoder3to8 dut (
        .in(in),
        .en(en),
        .out(out)
    );

    initial begin

        // Disable decoder
        en = 0;
        in = 3'b000;
        #10;
        $display("en=%b, in=%b, out=%b", en, in, out);

        // Enable and test all inputs
        en = 1;

        in = 3'b000;
        #10;
        $display("en=%b, in=%b, out=%b", en, in, out);

        in = 3'b001;
        #10;
        $display("en=%b, in=%b, out=%b", en, in, out);

        in = 3'b010;
        #10;
        $display("en=%b, in=%b, out=%b", en, in, out);

        in = 3'b011;
        #10;
        $display("en=%b, in=%b, out=%b", en, in, out);

        in = 3'b100;
        #10;
        $display("en=%b, in=%b, out=%b", en, in, out);

        in = 3'b101;
        #10;
        $display("en=%b, in=%b, out=%b", en, in, out);

        in = 3'b110;
        #10;
        $display("en=%b, in=%b, out=%b", en, in, out);

        in = 3'b111;
        #10;
        $display("en=%b, in=%b, out=%b", en, in, out);

        $finish;
    end

endmodule
